{
  "agent": {
    "region": "us-east-1",
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/devgarza/project1/nginx-access",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/devgarza/project1/nginx-error",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "/devgarza/project1/bootstrap",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
